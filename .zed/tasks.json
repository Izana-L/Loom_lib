// Tareas de Zed (command palette: "task: spawn"). Elige el preset y la acción.
//
// - "configurar" ejecuta el preset y copia compile_commands.json a la raíz
//   (clangd lo usa para el autocompletado). Ejecútalo al empezar y cada vez que
//   cambies de preset; mientras tanto "compilar" también mantiene esa copia al
//   día (al añadir o quitar archivos .cpp, o al cambiar un CMakeLists.txt).
// - "tests" ejecuta todos los tests con ctest (compila antes: ctest no compila).
// - "benchmarks" compila y ejecuta Loom_bench. Solo existe en los presets release:
//   una medida en Debug no vale.
// - linux-tsan (detector de carreras) y linux-asan (memoria) solo tienen "tests";
//   se configuran solos la primera vez.
// - Windows: abre Zed desde una "Developer PowerShell for VS" (cl.exe + $env{VSINSTALLDIR}).
[
  // ---------------- Linux linux-debug ----------------
  {
    "label": "Linux linux-debug: configurar",
    "command": "cmake",
    "args": ["-DPRESET=linux-debug", "-P", "cmake/configure-preset.cmake"]
  },
  {
    "label": "Linux linux-debug: compilar",
    "command": "cmake",
    "args": ["--build", "projects/out/build/linux-debug"]
  },
  {
    "label": "Linux linux-debug: tests",
    "command": "ctest",
    "args": ["--preset", "linux-debug"]
  },

  // ---------------- Linux linux-release ----------------
  {
    "label": "Linux linux-release: configurar",
    "command": "cmake",
    "args": ["-DPRESET=linux-release", "-P", "cmake/configure-preset.cmake"]
  },
  {
    "label": "Linux linux-release: compilar",
    "command": "cmake",
    "args": ["--build", "projects/out/build/linux-release"]
  },
  {
    "label": "Linux linux-release: tests",
    "command": "ctest",
    "args": ["--preset", "linux-release"]
  },
  {
    "label": "Linux linux-release: benchmarks",
    "command": "cmake",
    "args": ["--build", "projects/out/build/linux-release", "--target", "Loom_bench_run"]
  },

  // ---------------- Linux sanitizers ----------------
  // Una sola tarea por preset: configura, compila y ejecuta los tests.
  {
    "label": "Linux linux-tsan: tests (detector de carreras)",
    "command": "cmake --preset linux-tsan && cmake --build projects/out/build/linux-tsan && ctest --preset linux-tsan"
  },
  {
    "label": "Linux linux-asan: tests (memoria)",
    "command": "cmake --preset linux-asan && cmake --build projects/out/build/linux-asan && ctest --preset linux-asan"
  },

  // ---------------- Windows x64-debug ----------------
  {
    "label": "Windows x64-debug: configurar",
    "command": "cmake",
    "args": ["-DPRESET=x64-debug", "-P", "cmake/configure-preset.cmake"]
  },
  {
    "label": "Windows x64-debug: compilar",
    "command": "cmake",
    "args": ["--build", "projects/out/build/x64-debug"]
  },
  {
    "label": "Windows x64-debug: tests",
    "command": "ctest",
    "args": ["--preset", "x64-debug"]
  },

  // ---------------- Windows x64-release ----------------
  {
    "label": "Windows x64-release: configurar",
    "command": "cmake",
    "args": ["-DPRESET=x64-release", "-P", "cmake/configure-preset.cmake"]
  },
  {
    "label": "Windows x64-release: compilar",
    "command": "cmake",
    "args": ["--build", "projects/out/build/x64-release"]
  },
  {
    "label": "Windows x64-release: tests",
    "command": "ctest",
    "args": ["--preset", "x64-release"]
  },
  {
    "label": "Windows x64-release: benchmarks",
    "command": "cmake",
    "args": ["--build", "projects/out/build/x64-release", "--target", "Loom_bench_run"]
  }
]
